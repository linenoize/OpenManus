# OpenManus Environment Configuration

# LLM Provider Settings
# Uncomment and set values for the providers you want to use

# OpenAI settings
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic settings
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Local LLM settings
# ENABLE_LOCAL_LLM=true
# LOCAL_LLM_PATH=models/llama3
# LOCAL_LLM_API_URL=http://localhost:8000/v1

# Tool-specific API keys
# WEB_BROWSER_API_KEY=your_web_browser_api_key_here

# Set default LLM preferences
# DEFAULT_PLANNER_LLM=gpt4o
# DEFAULT_EXECUTOR_LLM=claude
# DEFAULT_TOOLAGENT_LLM=local

# Port configuration
# These settings are used in development and standard setup
# In unified container mode, only port 80 is exposed externally
FRONTEND_PORT=3000
API_PORT=5000
TOOLS_PORT=5001

# API client configuration
# Used by client.py and other API consumers
API_HOST=localhost
# API path prefix (used in unified setup, leave empty for standard setup)
API_PATH=api

# Storage settings
# Google Drive API settings (for file manager)
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8080

# Vector database settings
VECTOR_DB_BACKEND=faiss  # or chroma, milvus